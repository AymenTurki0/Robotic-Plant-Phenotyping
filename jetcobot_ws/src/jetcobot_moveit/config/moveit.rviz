          X: 0
          Y: 0
          Z: 0
        Size:
          X: 2
          Y: 2
          Z: 2
      Name: MotionPlanning
      Planned Path:
        Color Enabled: false
        Interrupt Display: false
        Links:
          1_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          2_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          3_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          4_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          5_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          6_Link:
            Alpha: 1
            Show Axes: false
            Show Trail: false
            Value: true
          All Links Enabled: true
