<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lab_world_plant1">

    <!-- Core simulation plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <!-- Scene ambient raised slightly + shadows kept on.
         Higher ambient = smaller gap between lit/shadowed regions,
         which keeps radiance closer to Lambertian across viewpoints
         (helps NeRF / Gaussian Splatting photometric consistency and
         MASt3R feature matching, which both degrade under high-contrast
         or view-dependent shading). -->
    <scene>
      <ambient>0.36 0.36 0.38 1</ambient>
      <background>0.4 0.4 0.44 1</background>
      <shadows>true</shadows>
    </scene>

    <gravity>0 0 -9.8</gravity>

    <!-- ============ GUI ============ -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.36 0.36 0.38</ambient_light>
        <background_color>0.4 0.4 0.44</background_color>
        <camera_pose>-1.0 -1.4 1.4 0 0.2 0.72</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"></plugin>
    </gui>

    <!-- ============ FLOOR ============ -->
    <!-- specular dropped 0.25 -> 0.05: a glossy floor throws a moving
         highlight across every frame as the camera orbits, which is
         exactly the kind of view-dependent radiance that confuses
         MASt3R correspondence and violates the static-radiance
         assumption behind vanilla NeRF/3DGS. -->
    <model name="lab_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material>
            <ambient>0.32 0.34 0.36 1</ambient>
            <diffuse>0.38 0.4 0.42 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="floor_mat">
      <static>true</static>
      <pose>0.5 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.6 1.4 0.002</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.16 1</ambient>
            <diffuse>0.18 0.18 0.19 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ WALLS ============ -->
    <!-- Walls already have no specular term (matte)  left as-is, this
         is the right baseline. Note at the end of this file about
         adding real texture maps for stronger SfM/feature-matching
         performance if you have texture assets available. -->
    <model name="wall_north_lower">
      <static>true</static>
      <pose>0 3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.31 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north_upper">
      <static>true</static>
      <pose>0 3 1.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.5 0.48 0.44 1</ambient><diffuse>0.58 0.56 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south_lower">
      <static>true</static>
      <pose>0 -3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.31 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south_upper">
      <static>true</static>
      <pose>0 -3 1.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.5 0.48 0.44 1</ambient><diffuse>0.58 0.56 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_lower">
      <static>true</static>
      <pose>3 0 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.2 0.23 0.25 1</ambient><diffuse>0.26 0.29 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east_upper">
      <static>true</static>
      <pose>3 0 1.7 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.47 0.45 0.42 1</ambient><diffuse>0.55 0.53 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_lower">
      <static>true</static>
      <pose>-3 0 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.2 0.23 0.25 1</ambient><diffuse>0.26 0.29 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_upper">
      <static>true</static>
      <pose>-3 0 1.7 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.47 0.45 0.42 1</ambient><diffuse>0.55 0.53 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ CEILING LIGHT FIXTURE PANELS (visual only) ============ -->
    <model name="light_fixture_1">
      <static>true</static>
      <pose>0.3 -0.6 2.47 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.25 0.04</size></box></geometry>
          <material>
            <ambient>1 1 0.95 1</ambient>
            <diffuse>1 1 0.95 1</diffuse>
            <emissive>0.35 0.35 0.32 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="light_fixture_2">
      <static>true</static>
      <pose>0.8 0.6 2.47 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.25 0.04</size></box></geometry>
          <material>
            <ambient>1 1 0.95 1</ambient>
            <diffuse>1 1 0.95 1</diffuse>
            <emissive>0.35 0.35 0.32 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ SCAN LIGHTING RIG ============ -->
    <!-- Redesigned as a symmetric 4-point ring centered over the new
         plant position (0.68, 0), all with ZERO/near-zero specular
         and wide, soft falloff (low linear/quadratic). Rationale:

         - A single dominant light (the old 2-light setup) creates one
           bright side and one dark side of the plant. As the robot's
           camera orbits 360°, every algorithm sees wildly different
           exposure on the near vs. far side -> bad for MASt3R matching
           and murders photometric consistency for NeRF/3DGS.
         - Specular terms on point lights are the #1 source of
           view-dependent glints on leaves -> those glints move or
           vanish between frames and get reconstructed as floating
           artifacts/noise in NeRF and as spurious high-opacity
           splats in Gaussian Splatting. Set to ~0 here.
         - 4 lights arranged N/E/S/W around the scan target + wide
           attenuation range = soft, close-to-omnidirectional fill,
           minimizing hard cast shadows that would otherwise flip
           on/off as occluders (robot arm, plant leaves) rotate
           relative to a single light. -->
    <light name="scan_light_N" type="point">
      <pose>0.54 0.45 2.1 0 0 0</pose>
      <diffuse>0.6 0.6 0.56 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="scan_light_S" type="point">
      <pose>0.54 -0.45 2.1 0 0 0</pose>
      <diffuse>0.6 0.6 0.56 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="scan_light_E" type="point">
      <pose>0.84 0 2.1 0 0 0</pose>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="scan_light_W" type="point">
      <pose>0.24 0 2.1 0 0 0</pose>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Two soft directional fills from opposing directions instead of
         one, so no single side of the room/plant is systematically
         under-lit relative to the other  important because your
         camera will pass through all headings during the 360 scan. -->
    <light name="fill_light_a" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="fill_light_b" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.3 -0.3 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============ LAB TABLE ============ -->
    <!-- Tabletop specular 0.6 -> 0.06 and legs 0.8 -> 0.08.
         The old values made the table a near-mirror: at grazing
         angles (which you WILL hit during a close 360 orbit a few cm
         from the plant) that throws large blown-out specular patches
         directly behind/around the subject, which both wrecks
         MASt3R's local feature matching in that region and gets
         baked into NeRF/3DGS as ghosted highlight blobs. -->
    <model name="lab_table">
      <static>true</static>
      <pose>0.5 0 0 0 0 0</pose>
      <link name="tabletop">

        <collision name="top_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
          <material>
            <ambient>0.16 0.16 0.17 1</ambient>
            <diffuse>0.22 0.22 0.23 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
          </material>
        </visual>

        <collision name="leg_fl_collision">
          <pose>0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.6 0.6 0.63 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>

        <collision name="leg_fr_collision">
          <pose>0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.6 0.6 0.63 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>

        <collision name="leg_bl_collision">
          <pose>-0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.6 0.6 0.63 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>

        <collision name="leg_br_collision">
          <pose>-0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.6 0.6 0.63 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ============ DETECTION ZONE MARKER ============ -->
    <!-- Moved from x=0.75 to x=0.68 to stay centered under the plant's
         new, closer-to-robot position. -->
    <model name="detection_zone_border">
      <static>true</static>
      <pose>0.54 0 0.7705 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.42 0.42 0.001</size></box></geometry>
          <material>
            <ambient>0.9 0.75 0.05 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="detection_zone_fill">
      <static>true</static>
      <pose>0.54 0 0.7715 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.38 0.38 0.001</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.09 1</ambient>
            <diffuse>0.1 0.1 0.11 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ PLANT ============ -->
    <!-- plant1/model1.sdf gives the REAL native size: collision box
         0.30 x 0.30 (footprint) x 0.60 (height) m at include-scale 1.0.
         The previous scale=0.6 therefore produced an actual 0.18m-wide,
         0.36m-tall plant sitting only 0.25m from the robot base that
         combination is what was hitting the arm.

         Fixes applied:
         - pose x: 0.40 -> 0.54, the exact midpoint between the two
           prior placements (0.68 and 0.40), giving horizontal distance
           from the robot base (~x=0.15) of 0.39 m  more breathing
           room for the arm/gripper/camera stack to sweep around it
           without clipping the pot or foliage.
         - scale: 0.6 -> 0.5, computed directly off the real 0.30/0.60m
           collision box -> final plant is 0.15m wide x 0.30m tall, a
           proportionate small tabletop pot instead of the oversized
           one from before.

         Note: at 0.39m base-to-plant distance, the jetcobot's ~0.52m
         max camera reach only leaves ~0.13m of extra radius for the
         far side of a full 360 orbit before nearing full extension 
         so keep the actual orbit/standoff radius from the plant
         surface tight (~10-15cm) rather than wide, or dexterity will
         suffer on the far azimuths. -->
    <include>
      <uri>model://plant1</uri>
      <pose>0.54 0 0.77 0 0 0</pose>
      <scale>0.5 0.5 0.35</scale>
    </include>

  </world>
</sdf>
