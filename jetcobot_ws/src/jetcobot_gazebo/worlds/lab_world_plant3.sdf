      </link>

      <joint name="turntable_joint" type="revolute">
        <parent>base_link</parent>
        <child>disc_link</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
            <effort>100</effort>
            <velocity>1.0</velocity> <!-- INCREASED: Allows faster full rotation -->
          </limit>
          <dynamics>
            <damping>0.1</damping>   <!-- REDUCED: Prevents resistance stall -->
            <friction>0.05</friction> <!-- REDUCED: Smooth rotation -->
          </dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>turntable_joint</joint_name>
        <topic>/turntable/cmd_pos</topic>
        <p_gain>200</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>5</d_gain>
        <i_max>5</i_max>
        <i_min>-5</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
      </plugin>

      <!-- ============ PLANT (nested, rigidly mounted on the disc) ============ -->
      <include>
        <name>plant3</name>
        <uri>model://plant3</uri>
        <pose>0 0 0.055 0 0 0</pose>
        <scale>0.5 0.5 0.35</scale>
        <static>false</static>
      </include>

      <joint name="plant_to_disc_joint" type="fixed">
        <parent>disc_link</parent>
        <child>plant3::link</child>
      </joint>

    </model>

  </world>
</sdf>