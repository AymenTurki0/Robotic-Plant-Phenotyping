<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lab_world_plant2">

    <!-- Core simulation plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <scene>
      <ambient>0.28 0.28 0.3 1</ambient>
      <background>0.4 0.4 0.44 1</background>
      <shadows>true</shadows>
    </scene>

    <gravity>0 0 -9.8</gravity>

    <!-- ============ GUI: camera starts inside the room, framing robot + workspace ============ -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.28 0.28 0.3</ambient_light>
        <background_color>0.4 0.4 0.44</background_color>
        <camera_pose>-1.0 -1.4 1.4 0 0.2 0.72</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"></plugin>
    </gui>

    <!-- ============ FLOOR ============ -->
    <model name="lab_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material>
            <ambient>0.32 0.34 0.36 1</ambient>
            <diffuse>0.38 0.4 0.42 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark anti-fatigue floor mat under the table -->
    <model name="floor_mat">
      <static>true</static>
      <pose>0.5 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.6 1.4 0.002</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.16 1</ambient>
            <diffuse>0.18 0.18 0.19 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ WALLS (two-tone: dark wainscot + light upper) ============ -->
    <!-- Room is 6m x 6m, wall height 2.5m, thickness 0.1m -->
    <!-- North -->
    <model name="wall_north_lower">
      <static>true</static>
      <pose>0 3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.31 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north_upper">
      <static>true</static>
      <pose>0 3 1.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.5 0.48 0.44 1</ambient><diffuse>0.58 0.56 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South -->
    <model name="wall_south_lower">
      <static>true</static>
      <pose>0 -3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.31 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south_upper">
      <static>true</static>
      <pose>0 -3 1.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.5 0.48 0.44 1</ambient><diffuse>0.58 0.56 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East -->
    <model name="wall_east_lower">
      <static>true</static>
      <pose>3 0 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.2 0.23 0.25 1</ambient><diffuse>0.26 0.29 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east_upper">
      <static>true</static>
      <pose>3 0 1.7 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.47 0.45 0.42 1</ambient><diffuse>0.55 0.53 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West -->
    <model name="wall_west_lower">
      <static>true</static>
      <pose>-3 0 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 0.9</size></box></geometry>
          <material><ambient>0.2 0.23 0.25 1</ambient><diffuse>0.26 0.29 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_upper">
      <static>true</static>
      <pose>-3 0 1.7 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.6</size></box></geometry>
          <material><ambient>0.47 0.45 0.42 1</ambient><diffuse>0.55 0.53 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ CEILING LIGHT FIXTURES (visual panel + point light) ============ -->
    <model name="light_fixture_1">
      <static>true</static>
      <pose>0.3 -0.6 2.47 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.25 0.04</size></box></geometry>
          <material>
            <ambient>1 1 0.95 1</ambient>
            <diffuse>1 1 0.95 1</diffuse>
            <emissive>0.5 0.5 0.46 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="light_fixture_2">
      <static>true</static>
      <pose>0.8 0.6 2.47 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.25 0.04</size></box></geometry>
          <material>
            <ambient>1 1 0.95 1</ambient>
            <diffuse>1 1 0.95 1</diffuse>
            <emissive>0.5 0.5 0.46 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <light name="ceiling_light_1" type="point">
      <pose>0.3 -0.6 2.4 0 0 0</pose>
      <diffuse>0.55 0.55 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.15</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>0.8 0.6 2.4 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.3</constant>
        <linear>0.06</linear>
        <quadratic>0.012</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="fill_light" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.25 0.25 0.25 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============ LAB TABLE (bigger, metal-leg, robot mounted near back edge) ============ -->
    <!-- Table centered at (0.5, 0, 0), footprint 1.0m (x) x 0.8m (y).
         Back edge at x=0.0, front edge at x=1.0.
         Robot is spawned near the back edge (x=0.15), leaving ~0.85m of
         open tabletop in front of it for placing objects to detect. -->
    <model name="lab_table">
      <static>true</static>
      <pose>0.5 0 0 0 0 0</pose>
      <link name="tabletop">

        <collision name="top_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.15 0.15 0.16 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>

        <!-- 4 metal legs (cylinders) -->
        <collision name="leg_fl_collision">
          <pose>0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>

        <collision name="leg_fr_collision">
          <pose>0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>

        <collision name="leg_bl_collision">
          <pose>-0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.45 0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>

        <collision name="leg_br_collision">
          <pose>-0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.45 -0.35 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.73</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ============ DETECTION ZONE MARKER ============ -->
    <!-- Marked area in the open front section of the table where objects
         will be placed for the robot's camera/vision pipeline to detect.
         Centered at world (0.75, 0), i.e. front-half of the table. -->
    <model name="detection_zone_border">
      <static>true</static>
      <pose>0.75 0 0.7705 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.42 0.42 0.001</size></box></geometry>
          <material>
            <ambient>0.9 0.75 0.05 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="detection_zone_fill">
      <static>true</static>
      <pose>0.75 0 0.7715 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.38 0.38 0.001</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.09 1</ambient>
            <diffuse>0.1 0.1 0.11 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  <include>
    <uri>model://plant2</uri>
    <pose>0.75 0 0.77 0 0 0</pose>
  </include>
  </world>
</sdf>
